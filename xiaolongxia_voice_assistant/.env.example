APP_ENV=dev
ASSISTANT_NAME=小龙虾
WAKE_WORD=小龙虾

# audio
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_FRAME_MS=30
AUDIO_SILENCE_MS=900
AUDIO_MAX_RECORD_SECONDS=15

# speech to text
STT_BACKEND=whisper_cpp
WHISPER_CPP_BIN=whisper-cli
WHISPER_CPP_MODEL=/absolute/path/to/ggml-base.bin
WHISPER_CPP_LANGUAGE=zh

# text to speech
TTS_BACKEND=macos_say
MACOS_SAY_VOICE=Tingting

# llm
LLM_BACKEND=mock
OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=qwen2.5:7b

# qq bot
QQ_BOT_APPID=
QQ_BOT_TOKEN=
QQ_BOT_SECRET=
QQ_DEFAULT_CHANNEL_OR_GROUP=
